{
  "name": "@foxy.io/sdk",
  "type": "module",
  "version": "0.0.0",
  "description": "Universal SDK for a full server-side and a limited in-browser access to Foxy hAPI.",
  "module": "dist/npm/index.js",
  "types": "dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js"
    },
    "./checkout": {
      "types": "./dist/npm/checkout/index.d.ts",
      "import": "./dist/npm/checkout/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:cdn": "vite build --mode cdn",
    "build:npm": "vite build --mode npm",
    "build:docs": "typedoc --excludePrivate --out dist/docs src/index.ts",
    "prepack": "npm run build:npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxy/foxy-sdk.git"
  },
  "keywords": [
    "foxycart",
    "foxy.io",
    "foxy",
    "serverless",
    "nodejs",
    "api",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/foxy/foxy-sdk/issues",
    "email": "hello@foxy.io"
  },
  "homepage": "https://sdk.foxy.dev",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.0.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  }
}
