{
  "name": "@foxy.io/sdk",
  "type": "module",
  "version": "0.0.0",
  "description": "Universal SDK for a full server-side and a limited in-browser access to Foxy hAPI.",
  "module": "dist/npm/index.js",
  "types": "dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js"
    },
    "./checkout": {
      "types": "./dist/npm/checkout.d.ts",
      "import": "./dist/npm/checkout.js"
    },
    "./checkout/loader": {
      "types": "./dist/npm/checkout/loader.d.ts",
      "import": "./dist/npm/checkout/loader.js"
    },
    "./checkout/client": {
      "types": "./dist/npm/checkout/client.d.ts",
      "import": "./dist/npm/checkout/client.js"
    },
    "./core": {
      "types": "./dist/npm/core.d.ts",
      "import": "./dist/npm/core.js"
    },
    "./customer": {
      "types": "./dist/npm/customer.d.ts",
      "import": "./dist/npm/customer.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "localdev:deploy:cdn": "npm run localdev:build:cdn && rm -rf ../foxy-docker-env-build/src/cdn-js/sdk@2 && cp -r dist/cdn ../foxy-docker-env-build/src/cdn-js/sdk@2",
    "localdev:build:cdn": "VITE_FOXYCART_DOMAIN=foxycart.test vite build --mode cdn",
    "build:cdn": "vite build --mode cdn",
    "build:npm": "vite build --mode npm",
    "build:docs": "typedoc --excludePrivate --out dist/docs src/index.ts",
    "generate:regions": "node scripts/generate-region-messages.mjs",
    "prepack": "npm run build:npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxy/foxy-sdk.git"
  },
  "keywords": [
    "foxycart",
    "foxy.io",
    "foxy",
    "serverless",
    "nodejs",
    "api",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/foxy/foxy-sdk/issues",
    "email": "hello@foxy.io"
  },
  "homepage": "https://sdk.foxy.dev",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.0.2",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  },
  "dependencies": {
    "@paypal/paypal-js": "^9.7.0",
    "@stripe/stripe-js": "^9.8.0",
    "jsonata": "^1.8.9",
    "parse-duration": "^2.1.8"
  }
}
