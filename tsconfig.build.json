{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "stripInternal": true
  },
  "include": [
    "src/admin/**/*",
    "src/checkout/**/*",
    "src/core/**/*",
    "src/customer/**/*",
    "src/rules/**/*",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/tests/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}