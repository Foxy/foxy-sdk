{
  "name": "foxy-sdk-site",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "prebuild": "npm run reference && node scripts/check-completeness.mjs && npm run examples:check",
    "reference": "node scripts/reference.mjs",
    "test": "vitest run",
    "examples:check": "tsc --noEmit -p tsconfig.examples.json",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.31",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.3",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
