{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@foxy.io/sdk/*": ["../src/*"],
      "https://cdn-js.foxy.io/sdk@2/*.js": ["../src/*"]
    }
  },
  "include": ["tests/examples.test-d.ts", "examples/**/*.ts", "../src/vite-env.d.ts"]
}
